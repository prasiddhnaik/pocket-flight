{
  "name": "pocket-flight",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "bun test ./tests",
    "physics:measure": "bun scripts/measure-collision-proxies.ts",
    "physics:calibrate": "bun scripts/calibrate-island.ts",
    "music:compose": "bun scripts/compose-soundtrack.ts",
    "music:verify": "bun scripts/verify-soundtrack.ts",
    "landing:check": "bun scripts/run-landing-browser-check.ts",
    "vfx:check": "bun scripts/run-flight-browser-check.ts vfx",
    "takeoff:check": "bun scripts/run-flight-browser-check.ts takeoff",
    "wing:check": "bun scripts/run-flight-browser-check.ts wing",
    "finch:measure": "bun scripts/measure-finch.ts",
    "finch:cockpit": "bun scripts/build-finch-cockpit.ts",
    "fleet:internals": "bun scripts/build-fleet-internals.ts && bun scripts/measure-fleet.ts --save && bun scripts/measure-collision-proxies.ts",
    "fleet:internals-native": "/Applications/Blender.app/Contents/MacOS/Blender --background --factory-startup --python scripts/save-fleet-internals.py",
    "lab:internals-check": "bun test ./tests/fleet-internal-systems.test.ts ./tests/finch-internal-systems.test.ts ./tests/aircraft-mechanics.test.ts ./tests/lab-optimization.test.ts ./tests/airflow.test.ts ./tests/wind-tunnel.test.ts && bun scripts/run-fleet-internals-check.ts",
    "finch:verify": "bun test tests/aerodynamics.test.ts tests/finch-geometry.test.ts tests/flight.test.ts",
    "stormbird:build": "bun scripts/build-stormbird.ts",
    "stormbird:inspect": "bun scripts/inspect-stormbird.ts",
    "stormbird:audit": "bun scripts/audit-stormbird.ts",
    "stormbird:viewer": "bun scripts/start-cad-viewer.ts",
    "lab:dev": "vite --config lab/vite.config.ts",
    "lab:build": "tsc -p lab/tsconfig.json && vite build --config lab/vite.config.ts",
    "lab:test": "bun test tests/wind-tunnel.test.ts tests/airflow.test.ts tests/lab-optimization.test.ts tests/aircraft-mechanics.test.ts",
    "lab:geometry": "bun scripts/measure-fleet.ts --save",
    "lab:model": "/Applications/Blender.app/Contents/MacOS/Blender --background --factory-startup --python lab/assets/build-tunnel.py",
    "lab:preview": "vite preview --config lab/vite.config.ts --host 127.0.0.1 --port 5186",
    "lab:audit": "bun scripts/audit-wind-tunnel.ts",
    "lab:browser": "bun scripts/run-lab-browser-check.ts",
    "lab:profile": "bun scripts/run-lab-browser-check.ts profile",
    "lab:optimize-check": "bun scripts/run-lab-browser-check.ts optimization",
    "lab:chamber-check": "bun scripts/run-lab-browser-check.ts chamber",
    "lab:mechanics-check": "bun scripts/run-lab-browser-check.ts mechanics",
    "lab:cockpit-check": "bun scripts/run-lab-browser-check.ts cockpit",
    "fleet:fuel-measure": "bun scripts/measure-fuel-and-mass.ts",
    "fleet:fuel-check": "bun test ./tests/fuel-mass.test.ts ./tests/aircraft-systems.test.ts ./tests/aurelia-balance.test.ts ./tests/gear-surface.test.ts ./tests/landing-gear.test.ts ./tests/fleet-dynamics.test.ts ./tests/envelope-validation.test.ts && bun scripts/report-fuel-mass.ts",
    "lab:fuel-check": "bun scripts/run-fuel-browser-check.ts",
    "aurelia:gear-build": "bun scripts/repair-aurelia-gear.ts && bun run fleet:internals && bun scripts/measure-fuel-and-mass.ts",
    "aurelia:gear-check": "bun test ./tests/aurelia-gear-packaging.test.ts ./tests/aircraft-mechanics.test.ts ./tests/fleet-internal-systems.test.ts ./tests/gear-surface.test.ts",
    "departure:measure": "bun scripts/measure-departure-clearance.ts",
    "departure:research": "bun run departure:measure && bun scripts/report-departure-research.ts"
  },
  "dependencies": {
    "@fix-webm-duration/fix": "1.0.1",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@playwright/cli": "latest",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.0",
    "fake-indexeddb": "^6.2.5",
    "prettier": "^3.9.6",
    "typescript": "^5.8.3",
    "vite": "^7.1.0"
  }
}
